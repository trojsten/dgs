(@ extends 'base.jtex' @)

(# Every part of a single problem in one document, for previewing while authoring.

   Deliberately *not* built on `base-booklet.jtex`: everything volume-shaped lives there
   (logo header, competition name, volume date, `i18n[...]`), and none of it says anything
   about the problem itself. Keeping this document to `base.jtex` means the whole context
   is five strings taken from the path, so a preview still builds for a volume whose
   `meta.yaml` or `languages/` tree does not.

   Geometry does match the booklet, though -- line breaking and overfull boxes are exactly
   what an author is checking for, and those depend on the text width.
 #)

(@ block documentclass @)oneside(@ endblock @)

(@ block specific @)
    \newgeometry{
        left                    = 15mm,
        right                   = 15mm,
        top                     = 15mm,
        bottom                  = 15mm,
        headheight              = 20pt,
        headsep                 = 16pt,
        footskip                = 32pt,
        includeheadfoot,
    }

    \fancypagestyle{standalone}{%
        \fancyhf{}
        \fancyhead[L]{\small\texttt{(* competition.id *)/(* volume.id *)/(* problem.id *)/(* language.id *)}}
        \fancyfoot[C]{\small \thepage}
        \renewcommand{\headrulewidth}{0.4pt}
        \renewcommand{\footrulewidth}{0pt}
        (# Copied from `base-booklet.jtex`: a part is headed by its problem number in a 7mm
           framed box, run in with the text that follows. The preview is for judging how a
           problem will look in print, so its headings have to be the printed ones. #)
        \titleformat{\subsection}[runin]{\bfseries}{}{0pt}{\setlength{\fboxsep}{3pt}\framebox[7mm]}[\setlength{\fboxsep}{0pt}]
        \titleformat{\subsubsection}[hang]{\bfseries}{}{0pt}{}[]
        \titleformat{\paragraph}[hang]{\bfseries\itshape}{}{0pt}{}[]
        \titlespacing*{\subsection}{0pt}{8pt}{8pt}
        \titlespacing*{\subsubsection}{0pt}{8pt}{0pt}
        \titlespacing*{\paragraph}{0pt}{8pt}{-1em}
    }
    \setcounter{secnumdepth}{3}

    (# Carries `\selectlanguage`, the localised decimal separator for siunitx,
       and the `\crefname`s that pandoc-crossref references resolve against. #)
    \input{build/core/i18n/(* language.id *).tex}

    \pagestyle{standalone}
(@ endblock @)

(@ block content @)
    (# There is no volume here, so `base.jtex`'s `\arabic{problem}.\arabic{equation}` would
       number every equation `0.1`, `0.2`, ... Drop the problem prefix. This has to happen in
       `content`, not `specific`: `base.jtex` emits its own `\renewcommand`s in between. #)
    \renewcommand{\theequation}{\arabic{equation}}%
    \renewcommand{\thefigure}{\arabic{figure}}%
    \renewcommand{\thetable}{\arabic{table}}%

    (# Pictures are `\insertPicture{<name>}`, resolved against `\activeDirectory`.
       Get this path wrong and every figure silently degrades to `example-image`. #)
    \setActive{\rootDirectory/(* module.id *)/(* competition.id *)/(* volume.id *)/problems/(* problem.id *)}%

    (# Each part is headed exactly as the booklet heads it: the problem's number in a framed box,
       run in with the text. The booklet tells problem from solution from answer by which of its
       three sections you are in; here they simply follow one another, in that order.

       Guarded with `\IfFileExists` rather than in Jinja: the document is rendered once and then
       compiled against whatever the Makefile actually built, and an optional part may appear or
       vanish without the context ever changing. #)
    \IfFileExists{\activeDirectory/(* language.id *)/problem.tex}{%
        \subsection{\texorpdfstring{(* problem.number *)}{(* problem.number *). (* problem.id *) -- problem}}%
        \setcounter{equation}{0}%
        \setcounter{table}{0}%
        \setcounter{figure}{0}%
        \protectedInput{\activeDirectory/(* language.id *)/problem.tex}%
    }{}%
    (# `problem-extra` exists to be torn off separately: `tearoff.jtex` runs a second pass over
       every problem after the closing page and gives each extra its own sheet, numbered `N*`.
       The booklet has no pages to hand out and simply appends it to the statement, but the
       preview must not -- being a separate sheet is the whole point of the file, so it gets its
       own page here too, and the tearoff's `*` marker. #)
    \IfFileExists{\activeDirectory/(* language.id *)/problem-extra.tex}{%
        \newpage%
        \subsection{\texorpdfstring{(* problem.number *)*}{(* problem.number *)*. (* problem.id *) -- problem extra}}%
        \setcounter{equation}{0}%
        \setcounter{table}{0}%
        \setcounter{figure}{0}%
        \protectedInput{\activeDirectory/(* language.id *)/problem-extra.tex}%
    }{}%
    \IfFileExists{\activeDirectory/(* language.id *)/solution.tex}{%
        \subsection{\texorpdfstring{(* problem.number *)}{(* problem.number *). (* problem.id *) -- solution}}%
        \setcounter{equation}{0}%
        \setcounter{table}{0}%
        \setcounter{figure}{0}%
        \protectedInput{\activeDirectory/(* language.id *)/solution.tex}%
    }{}%
    \IfFileExists{\activeDirectory/(* language.id *)/answer.tex}{%
        \subsection{\texorpdfstring{(* problem.number *)}{(* problem.number *). (* problem.id *) -- answer}}%
        \setcounter{equation}{0}%
        \setcounter{table}{0}%
        \setcounter{figure}{0}%
        (@ include 'blocks/answer-body.jtex' @)%
    }{}%
(@ endblock @)
