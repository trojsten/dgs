(@ extends 'base.jtex' @)

(@ block documentclass @)twoside(@ endblock @)

(@ block specific @)
    \newgeometry{
        left                    = 15mm,
        right                   = 15mm,
        top                     = 15mm,
        bottom                  = 15mm,
        headheight              = 20pt,
        headsep                 = 16pt,
        footskip                = 32pt,
        includeheadfoot,
    }

    \fancypagestyle{naboj}{%
        \fancyhead[LO,RE]{%
            \raisebox{(* competition.hacks.smallLogoRaise *)}{%
                \includegraphics[keepaspectratio=true, height=6mm]{build/(* module.id *)/(* competition.id *)/.static/logo/logo.pdf}%
            }%
        }%
        \fancyhead[C]{\textit{(* volume.number *). (* i18n[language.id].competition.name.nominative *), (* volume.date.strftime('%Y') *)}}
        \fancyfoot[LO,RE]{\href{mailto:(* i18n[language.id].competition.email *)}{\texttt{(* i18n[language.id].competition.email *)}}}
        \fancyfoot[C]{\small \thepage}
        \fancyfoot[LE,RO]{\URL{(* i18n[language.id].competition.website *)}}
        \titleformat{\section}[hang]{\centering\huge\vspace*{-7mm}}{}{0pt}{}
        \titleformat{\subsection}[runin]{\bfseries}{}{0pt}{\setlength{\fboxsep}{3pt}\framebox[7mm]}[\setlength{\fboxsep}{0pt}]
        \titleformat{\subsubsection}[hang]{\bfseries}{}{0pt}{}[]
        \titleformat{\paragraph}[hang]{\bfseries\itshape}{}{0pt}{}[]
        \titlespacing*{\section}{0pt}{0pt}{8pt}
        \titlespacing*{\subsection}{0pt}{8pt}{8pt}
        \titlespacing*{\subsubsection}{0pt}{8pt}{0pt}
        \titlespacing*{\paragraph}{0pt}{8pt}{-1em}
    }

    \fancypagestyle{first}{%
        \fancyhf{}
        \fancyhead[L]{
            \begin{minipage}{0.15\textwidth}
                \flushleft
                \includegraphics[height=20mm]{assets/logo/trojsten/logo.pdf}\\[0pt]
                \vspace{16pt}
            \end{minipage}
        }
        \fancyhead[C]{
            \begin{minipage}{0.7\textwidth}
                \centering
                \vspace{4pt}
                {\Large (* volume.number *). (* i18n[language.id].competition.name.nominative *)}\\[4pt]
                {\large (* volume.date.strftime('%d. %m. %Y') *)}\\[8pt]
                {\footnotesize (* competition.organisation.name *)}\\[2pt]
                \vspace{6pt}
            \end{minipage}
        }
        \fancyhead[R]{
            \begin{minipage}{0.2\textwidth}
                \flushright
                \includegraphics[width=30mm, keepaspectratio=true]{%
                    build/(* module.id *)/(* competition.id *)/.static/logo/logo.pdf%
                }\\[0pt]
                \vspace{4pt}
            \end{minipage}
        }
        \fancyfoot[LO,RE]{%
            \href{%
                mailto:(* i18n[language.id].competition.email *)%
            }{%
                \texttt{(* i18n[language.id].competition.email *)}%
            }%
        }
        \fancyfoot[C]{\small \thepage}
        \fancyfoot[LE,RO]{\URL{(* i18n[language.id].competition.website *)}}
        \titleformat{\subsection}[hang]{\bfseries}{}{0pt}{}[]
    }

    \fancypagestyle{problems}{%
        \pagestyle{naboj}
        \fancyhead[LE,RO]{\textit{(* i18n[language.id].section.problems *)}}
    }

    \fancypagestyle{solutions}{%
        \pagestyle{naboj}
        \fancyhead[LE,RO]{\textit{(* i18n[language.id].section.solutions *)}}
    }

    \fancypagestyle{answers}{%
        \pagestyle{naboj}
        \fancyhead[LE,RO]{\textit{(* i18n[language.id].section.answers *)}}
    }

    (# **Only a booklet has a colophon**, so the whole apparatus lives in `booklet.jtex` and
        this is the seam it fills. It used to stand here, which made it every document's --
        and this base is not the booklet's alone. `instructions.jtex` and `answers-modulo.jtex`
        extend it too, for the geometry, the logo header and the footer, and a venue document
        has no contents list to end on, no credits page, and never asks for `\pagestyle{colophon}`:
        `blocks/booklet/footer.jtex` is what does, and only `booklet.jtex` includes it. So they
        were defining a style, a savebox and an `\AtBeginDocument` hook they could not use.

        It was also fatal rather than merely wasteful, because `language` is not one thing here.
        In a language build it is the language *meta* -- `booklet`, `name`, `translators`; in a
        venue build it is the i18n descriptor -- `cref`, `quotes`, `siunitx`, `typography` --
        and the two share only `id` and `rtl`. The colophon reached for `language.booklet` and
        `language.name`, so every venue document in the repository stopped building the day it
        was added. Anything in this shared base that touches `language` beyond those two keys
        has the same fault waiting in it. #)
(@ block colophon @)(@ endblock @)

    \setcounter{secnumdepth}{3}
    \input{build/core/i18n/(* language.id *).tex}

    \pagestyle{naboj}
(@ endblock @)

(@ block metadata @)(@ include 'blocks/metadata.jtex' @)(@ endblock @)
