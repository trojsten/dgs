(@ extends 'base.jtex' @)

(@ block documentclass @)twoside(@ endblock @)

(@ block specific @)
    \newgeometry{
        left                    = 15mm,
        right                   = 15mm,
        top                     = 15mm,
        bottom                  = 15mm,
        headheight              = 20pt,
        headsep                 = 16pt,
        footskip                = 32pt,
        includeheadfoot,
    }

    \fancypagestyle{naboj}{%
        \fancyhead[LO,RE]{%
            \raisebox{(* competition.hacks.smallLogoRaise *)}{%
                \includegraphics[keepaspectratio=true, height=6mm]{build/(* module.id *)/(* competition.id *)/.static/logo/logo.pdf}%
            }%
        }%
        \fancyhead[C]{\textit{(* volume.number *). (* i18n[language.id].competition.name.nominative *), (* volume.date.strftime('%Y') *)}}
        \fancyfoot[LO,RE]{\href{mailto:(* i18n[language.id].competition.email *)}{\texttt{(* i18n[language.id].competition.email *)}}}
        \fancyfoot[C]{\small \thepage}
        \fancyfoot[LE,RO]{\URL{(* i18n[language.id].competition.website *)}}
        \titleformat{\section}[hang]{\centering\huge\vspace*{-7mm}}{}{0pt}{}
        \titleformat{\subsection}[runin]{\bfseries}{}{0pt}{\setlength{\fboxsep}{3pt}\framebox[7mm]}[\setlength{\fboxsep}{0pt}]
        \titleformat{\subsubsection}[hang]{\bfseries}{}{0pt}{}[]
        \titleformat{\paragraph}[hang]{\bfseries\itshape}{}{0pt}{}[]
        \titlespacing*{\section}{0pt}{0pt}{8pt}
        \titlespacing*{\subsection}{0pt}{8pt}{8pt}
        \titlespacing*{\subsubsection}{0pt}{8pt}{0pt}
        \titlespacing*{\paragraph}{0pt}{8pt}{-1em}
    }

    \fancypagestyle{first}{%
        \fancyhf{}
        \fancyhead[L]{
            \begin{minipage}{0.15\textwidth}
                \flushleft
                \includegraphics[height=20mm]{assets/logo/trojsten/logo.pdf}\\[0pt]
                \vspace{16pt}
            \end{minipage}
        }
        \fancyhead[C]{
            \begin{minipage}{0.7\textwidth}
                \centering
                \vspace{4pt}
                {\Large (* volume.number *). (* i18n[language.id].competition.name.nominative *)}\\[4pt]
                {\large (* volume.date.strftime('%d. %m. %Y') *)}\\[8pt]
                {\footnotesize (* competition.organisation.name *)}\\[2pt]
                \vspace{6pt}
            \end{minipage}
        }
        \fancyhead[R]{
            \begin{minipage}{0.2\textwidth}
                \flushright
                \includegraphics[width=30mm, keepaspectratio=true]{%
                    build/(* module.id *)/(* competition.id *)/.static/logo/logo.pdf%
                }\\[0pt]
                \vspace{4pt}
            \end{minipage}
        }
        \fancyfoot[LO,RE]{%
            \href{%
                mailto:(* i18n[language.id].competition.email *)%
            }{%
                \texttt{(* i18n[language.id].competition.email *)}%
            }%
        }
        \fancyfoot[C]{\small \thepage}
        \fancyfoot[LE,RO]{\URL{(* i18n[language.id].competition.website *)}}
        \titleformat{\subsection}[hang]{\bfseries}{}{0pt}{}[]
    }

    \fancypagestyle{problems}{%
        \pagestyle{naboj}
        \fancyhead[LE,RO]{\textit{(* i18n[language.id].section.problems *)}}
    }

    \fancypagestyle{solutions}{%
        \pagestyle{naboj}
        \fancyhead[LE,RO]{\textit{(* i18n[language.id].section.solutions *)}}
    }

    \fancypagestyle{answers}{%
        \pagestyle{naboj}
        \fancyhead[LE,RO]{\textit{(* i18n[language.id].section.answers *)}}
    }

    (# The last page carries the credits, and the colophon is that page's footer rather than a
        block of body text above it -- `blocks/colophon.jtex` says what is in it, and
        `blocks/booklet/footer.jtex` asks for the style once the credits are laid down.

        **It is boxed here and used there**, which is what keeps the two halves of the
        arrangement in step. A footer grows *upward* from its baseline, so the colophon rises
        into the gap between the credits and the footrule -- and the credits are seated flush
        with the bottom of the text block, so without a reservation the rule cut through the
        last name on the page. The reservation is this box's own height rather than a length
        somebody measured off a proof: resize the type or add a row and the gap follows.
        `\thepage` stays outside the box, because a page number frozen in the preamble would
        print whatever page the box was built on.

        Only the centre field changes, so the style inherits the one the booklet ends in: the
        running head on that page still belongs to the last section, and a `colophon` built on
        `naboj` would drop the `Výsledky` beside the logo. fancyhdr 4's optional base argument
        is what makes that one line rather than a copy of the section style. #)
    \newsavebox{\dgsColophonBox}
    \newlength{\dgsColophonRise}
    (# The colophon sits closer to its own second row than to the footer line below it, or the
        three read as one block of small print rather than as a colophon over a footer. One
        length, used by the style and by the reservation, so the two cannot disagree. #)
    \newlength{\dgsColophonGap}
    \setlength{\dgsColophonGap}{3mm}
    \AtBeginDocument{%
        \sbox{\dgsColophonBox}{%
            \parbox{\textwidth}{\centering (@ include 'blocks/colophon.jtex' @)}%
        }%
        \setlength{\dgsColophonRise}{%
            \dimexpr\ht\dgsColophonBox + \dp\dgsColophonBox + \dgsColophonGap\relax
        }%
    }
    (@ set colophon_base = 'answers' if language.booklet.contents.answers
        else 'solutions' if language.booklet.contents.solutions
        else 'problems' if language.booklet.contents.problems
        else 'naboj' @)
    \fancypagestyle{colophon}[(* colophon_base *)]{%
        \fancyfoot[C]{%
            \makebox[0pt]{%
                \parbox[b]{\textwidth}{%
                    \centering
                    \usebox{\dgsColophonBox}\par
                    \vspace{\dgsColophonGap}%
                    \small \thepage
                }%
            }%
        }%
    }

    \setcounter{secnumdepth}{3}
    \input{build/core/i18n/(* language.id *).tex}

    \pagestyle{naboj}
(@ endblock @)

(@ block metadata @)(@ include 'blocks/metadata.jtex' @)(@ endblock @)
