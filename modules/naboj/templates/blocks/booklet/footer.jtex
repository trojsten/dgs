(# A list nobody is on prints nothing at all, heading included. `itemize` refuses to be
    empty -- `Something's wrong--perhaps a missing \item` -- and six volumes have at least one
    empty list: the legacy and part-converted ones, 02, 03, 10, 12, 18 and chem/01. A heading
    with nothing under it would be worse than no heading anyway. #)
(@ macro list(title, people) @)
    (@ if people|length > 0 @)
    \subsubsection*{(* title|capitalize *)}
    \setlength{\columnsep}{-15mm}
    \begin{multicols}{3}
        \begin{itemize}[label={}, itemsep=-1mm]
            (@ for person in people @)
                \item (* person *)
            (@ endfor @)
            (@ if people|length % 3 == 1 @)\item\item(@ endif @)
            (@ if people|length % 3 == 2 @)\item(@ endif @)
        \end{itemize}
    \end{multicols}
    (@ endif @)
(@ endmacro @)

\begin{footerBlock}
    (* list(i18n[language.id].people.authors, volume.authors.problems) *)
    (* list(i18n[language.id].people.pictures, volume.authors.pictures) *)
    (* list(i18n[language.id].people.editors, volume.authors.editors) *)
    (@ if language.id != 'sk' and language.translators|length > 0 @)%
    (* list(i18n[language.id].people.translators, language.translators) *)
    (@ endif @)

    (@ with colocolor='lightgray' @)
        (@ include 'blocks/colophon.jtex' @)
    (@ endwith @)
\end{footerBlock}
