% A figure belongs to the problem it was written in and may not drift into the next one. The
% barrier at the top of this block is also the end of the previous problem, so one line per block
% fences every problem on both sides -- and the last one is fenced by \end{document}.
%
% This matters more than it looks: the \setcounter{figure}{0} below renumbers from 1 per problem,
% so a figure that drifted forward would print its own number under a heading whose counter has
% been reset. \FloatBarrier costs nothing when nothing is deferred, which with [H] is always.
\FloatBarrier%
\hypersetup{linkcolor=black}%
\setcounter{equation}{0}%
\setcounter{table}{0}%
\setcounter{figure}{0}%
\setcounter{problem}{(* problem.number *)}%
\setActive{\rootDirectory/(* module.id *)/(* competition.id *)/(* volume.id *)/problems/(* problem.id *)}%
\subsection{%
    \texorpdfstring{%
        \hyperref[sec:(* problem.id *):answer]{(* problem.number *)}%
    }{%
        (* problem.number *). (* problem.id *)%
    }%
}%
\label{sec:(* problem.id *):problem}%
\hypersetup{linkcolor=colour-link}%
\protectedInput{\activeDirectory/(* language.id *)/problem.tex}%
\IfFileExists{\activeDirectory/(* language.id *)/problem-extra.tex}{%
    \protectedInput{\activeDirectory/(* language.id *)/problem-extra.tex}%
}{}%
