\setcounter{volume}{(* volume.number *)}%
\setcounter{problem}{(@ block probnum @)(* problem.number *)(@ endblock probnum @)}%
\setcounter{equation}{0}%
\setcounter{table}{0}%
\setcounter{figure}{0}%

(@ block activate @)
    \input{build/core/i18n/(* language.id *).tex}
    \setActive{\rootDirectory/(* module.id *)/(* competition.id *)/(* volume.id *)/problems/(* problem.id *)}%
(@ endblock activate @)

\begin{minipage}[t][(* competition.tearoff.height *)mm][t]{187mm}%
    (@ block main @)
        \subsection{\texorpdfstring{(* problem.number *)}{(* language.id *): (* problem.number *). (* problem.id *)}}%
        \begin{minipage}[t][(* competition.tearoff.inner *)mm][t]{0.86\linewidth}%
            \setlength{\parskip}{6pt}
            (# `\tearoffPictures` makes a figure's tear-off height `th` the one that counts,
               where it declares one; every other document ignores the key and prints the plain `height`.
               The minipage is already a group, so it rolls back on its own -- see
               `core/latex/utilities.tex`. #)
            \tearoffPictures%
            \protectedInput{\activeDirectory/(* language.id *)/problem.tex}%
            \tearoffTail%
        \end{minipage}%
    (@ endblock main @)
\end{minipage}
