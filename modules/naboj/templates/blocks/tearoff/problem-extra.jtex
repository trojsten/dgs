(@ block activate @)
    \input{build/core/i18n/(* language.id *).tex}
    \setActive{\rootDirectory/(* module.id *)/(* competition.id *)/(* volume.id *)/problems/(* problem.id *)}%
(@ endblock activate @)

\IfFileExists{\activeDirectory/(* language.id *)/problem-extra.tex}{%
    \newpage%
    \begin{minipage}[t][(* competition.tearoff.height *)mm][t]{\textwidth}%
        \begin{minipage}[t][(* competition.tearoff.inner *)mm][t]{0.86\linewidth}%
            \subsection{\texorpdfstring{(* problem.number *)*}{(* language.id *): (* problem.number *)*. (* problem.id *)-extra}}
            ~
            \vspace{\stretch{1}}%
            (# As in `problem.jtex`: the tear-off is the one document that honours a figure's
               `tearoff_height`, and the minipage scopes it.

               An extra is centred as a block, and its own glue has to be the same order as the
               glue `\tearoffPictures` puts around a drawing -- a `\vfill` here is a first-order
               `fil` and would lose the whole leftover to the drawing's `fill`, so an extra with
               a figure in it would stop being centred at all. No `\tearoffTail` for the same
               reason: the glue below is already here. #)
            \tearoffPictures%
            \protectedInput{\activeDirectory/(* language.id *)/problem-extra.tex}%
            \vspace{\stretch{1}}%
            ~
        \end{minipage}%
    \end{minipage}%
}{}

