(# The line that follows a problem's title: what it is worth, and who wrote and marked it.

   One file, imported by the booklets and by the standalone preview alike, because a preview
   exists to show how a problem will look in print and a heading that differs from the booklet's
   is the one thing it must not do. Written out in both places they drift, which is the same
   argument `eq:` makes for equations.

   Each macro is whitespace-controlled rather than `%`-terminated: a macro's own indentation would
   otherwise reach the page, and the booklets call these from inside a `\texorpdfstring`. #)

(# `9 bodov`, and the categories where a round has them. #)
(@ macro worth(problem) -@)
    (@- if problem.points is defined and problem.points.description is defined -@)
        \textbf{(* problem.points.description *) bod(* problem.points.description|plural("","y","ov") *)}
    (@- endif -@)
    (@- if problem.categories -@)
        , kategóri(* plural(problem.categories|length, "a", "e", "e") *) (* problem.categories|format_list(func=textbf) *)
    (@- endif -@)
(@- endmacro @)

(# `vzorák Pat, opravovala Mat`. The suffix follows the gender of whoever marked it, which is
   `format_gender_suffix`'s whole job. #)
(@ macro credits(problem) -@)
    (@- if problem.solution -@)
        vzorák (* problem.solution|format_people(func=textbf) *)
    (@- endif -@)
    (@- if problem.evaluation -@)
        , opravoval(* problem.evaluation|format_gender_suffix *) (* problem.evaluation|format_people(func=textbf) *)
    (@- endif -@)
(@- endmacro @)
