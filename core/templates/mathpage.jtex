% Every formula of one HTML page, typeset by the LaTeX that typesets the booklet.
%
% The package list is `standalone.jtex`'s, deliberately and in the same order: the maths on the
% web has to be set by the same macros, the same siunitx settings and the same fonts as the
% maths in print, or the two drift and nobody notices until a reader compares them. A package
% added there belongs here too.
\documentclass[multi=dgsmath, border=0pt]{standalone}

\RequirePackage[table]{xcolor}
\RequirePackage{tikz}

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{mleftright}
\RequirePackage{siunitx}
\RequirePackage[weather]{ifsym}
\RequirePackage{nicematrix}

\RequirePackage{wasysym}                                    % extra symbols for planets, astrology, ...
\RequirePackage{mathtools}
\RequirePackage[version=4]{mhchem}                          % simple chemical formulae
\RequirePackage{chemformula}
\RequirePackage{chemmacros}
\RequirePackage{chemfig}                                    % complex chemical formulae

\RequirePackage[all]{nowidow}                               % prevent widow and orphan lines
\RequirePackage[minionint, mathlf]{MinionPro}
\RequirePackage[MnSymbol]{mathspec}                         % includes fontspec
\RequirePackage[f]{esvect}
\RequirePackage{accents}
\RequirePackage{caption}
\RequirePackage{cleveref}

\RequirePackage[
    shorthands=off,
    slovak,
    czech,
    english,
    german,
    french,
    polish,
    spanish,
]{babel}                                                    % multi-language support
\RequirePackage[autostyle]{csquotes}                        % proper localized quotation marks

\input{core/latex/fonts.tex}
\input{core/latex/utilities.tex}
\input{core/latex/math.tex}
\input{core/latex/symbols.tex}
\input{core/latex/siunitx.tex}

\input{build/core/i18n/(* lang *).tex}

\usetikzlibrary{decorations.markings}
\usetikzlibrary{matrix, backgrounds, fit, positioning}

\setchemfig{
    atom sep=7mm,
    bond style={line width=1pt},
    bond join=true,
    schemestart code=\chemnameinit{},
}
\tikzset{
  over line/.style={
    white,
    double=black,
    double distance=\the\pgflinewidth,
    line width=1.5pt,
  },
  under line/.style={
    decoration={
      markings,
      mark connection node=mid node,
      mark=at position #1 with {}
      {\node[transform shape,minimum size=3pt] (mid node) {};}
    },
    decorate
  }
}


% Every formula on a page of its own, measured as it is set.
%
% `multi=dgsmath` makes each `dgsmath` environment its own page, so one xelatex run typesets a
% whole HTML page's worth of maths instead of one formula. The box is measured before it is
% shipped, and the three numbers go to the log: height, depth, and the font's x-height.
%
% The depth is the point of it. An inline formula has to sit on the surrounding text's baseline,
% and an image does not know where its baseline is -- which is what made the first attempt at
% this drop every inline formula onto a line of its own. `height` and `vertical-align` in `ex`,
% computed from these three, put it back.
\newsavebox{\dgsmathbox}
\newenvironment{dgsmath}
    {\begingroup\setbox\dgsmathbox=\hbox\bgroup}
    {\egroup
     \typeout{DGSMETRIC \the\ht\dgsmathbox\space \the\dp\dgsmathbox\space \the\fontdimen5\font}%
     \usebox{\dgsmathbox}\endgroup}

\begin{document}
(* content *)
\end{document}
